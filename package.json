{
  "name": "ari",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --outDir .local/preview-dist",
    "start": "tsx server/index.ts",
    "start:background": "node scripts/local-server.mjs start",
    "stop": "node scripts/local-server.mjs stop",
    "status": "node scripts/local-server.mjs status",
    "backup": "node scripts/backup.mjs",
    "onboarding": "node scripts/onboarding.mjs",
    "test": "tsx --test tests/*.test.ts",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "privacy:check": "node scripts/check-public-files.mjs --history"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "katex": "^0.16.21",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "parse5": "^8.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "license": "MIT"
}
