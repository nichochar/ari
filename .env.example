# ChatGPT sign-in through the Codex CLI (no API key needed).
# Install: npm install -g @openai/codex@0.163.0
# Sign in: codex -c 'cli_auth_credentials_store="file"' login
GENIE_AI_PROVIDER=codex
GENIE_MAIN_PROVIDER=codex
# Codex must be on PATH, or set this to its absolute executable path.
CODEX_BIN=codex

# Use model IDs available to your ChatGPT account. No automatic model fallback.
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=low
CODEX_TUTOR_MODEL=gpt-6-astra
CODEX_TUTOR_REASONING_EFFORT=high
CODEX_MAIN_MODEL=gpt-6-astra
LEARNING_COMPACTION_TOKENS=64000
PORT=3001

# Optional, separately billed API mode (requires explicit provider selection).
# GENIE_AI_PROVIDER=openai
# GENIE_MAIN_PROVIDER=openai
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=gpt-5.4
# OPENAI_MAIN_MODEL=gpt-6-astra
