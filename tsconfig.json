{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "noEmit": true, "types": ["node"],
    "baseUrl": ".", "paths": { "@/*": ["src/*"], "@ari/plot": ["packages/plot/src/index.ts"], "@ari/plot/*": ["packages/plot/src/*"] }
  },
  "include": ["src", "server", "shared", "tests", "vite.config.ts", "packages/plot/src", "packages/plot/test"]
}
